VITE_FIREBASE_API_KEY=AIzaSyDsG81Moo9f3vgnYiWfdZDHT7QrBFuL0Sc
# The hosting domain itself, so the OAuth handshake stays same-origin (needed
# under browser third-party-storage partitioning). Requires the OAuth client in
# Google Cloud Console → Credentials to list
# https://fluted-citizen-269819.web.app/__/auth/handler as an authorized
# redirect URI — done 2026-08-12; without it Google rejects sign-in with
# "Error 400: redirect_uri_mismatch".
VITE_FIREBASE_AUTH_DOMAIN=fluted-citizen-269819.web.app
VITE_FIREBASE_PROJECT_ID=fluted-citizen-269819
