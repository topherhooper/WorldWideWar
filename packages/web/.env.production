VITE_FIREBASE_API_KEY=AIzaSyDsG81Moo9f3vgnYiWfdZDHT7QrBFuL0Sc
# The domain the site is actually served from, so the OAuth handshake stays same-origin.
# That matters for the signInWithRedirect fallback (mobile, popup blockers): browser
# third-party-storage partitioning breaks the redirect round-trip when authDomain is a
# different origin than the page. Hosting serves the real /__/auth/handler on every
# domain attached to the project, custom ones included, so no rewrite is needed —
# firebase.json's catch-all does not shadow the reserved /__/ namespace.
#
# Whatever this points at, the matching https://<domain>/__/auth/handler must be an
# authorized redirect URI on OAuth client 614936797883-c24n36s0orbm3s0ff6pgu1lt725imip7
# (Cloud Console → Credentials) or Google rejects sign-in with "Error 400:
# redirect_uri_mismatch". Authorized: .web.app 2026-08-12, play 2026-08-14.
VITE_FIREBASE_AUTH_DOMAIN=play.topherhooper.com
VITE_FIREBASE_PROJECT_ID=fluted-citizen-269819
# FCM / web push. All three are public identifiers, like the API key above.
# The sender ID is the project number (614936797883).
VITE_FIREBASE_MESSAGING_SENDER_ID=614936797883
# Firebase Console → Project settings → General → the www-web app's config → appId.
VITE_FIREBASE_APP_ID=1:614936797883:web:e3230fa57ea51bb8293f9e
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates, key pair
# generated 2026-10-01; this is the public key. Empty keeps push reported as unsupported.
VITE_FIREBASE_VAPID_KEY=BNj-7PVlU5oD2QQYbHWQD90dMwF65dNTV-8jt8pHKMIWDPqc7XtRyDwzJMC6UzsVOGH5LsxlDUAa62-qiMym4sY
