node_modules/
# Left behind by the podman gate in CLAUDE.md -- 500MB, never committable.
.pnpm-store/
dist/
build/
coverage/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# data
*.db
*.db-wal
*.db-shm
data/

# generated artifacts
out/
tools/mapviz/out/

# editors / os
.DS_Store
.idea/
.vscode/
*.log

.claude/settings.local.json

# Documentation is never generated output. The build-output patterns above are
# unanchored, so a doc directory that happens to be named out/, data/ or build/
# would otherwise vanish silently.
!docs/**
